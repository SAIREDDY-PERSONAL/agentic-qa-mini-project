# The LLM judge uses the first provider configured below:
# Anthropic if ANTHROPIC_API_KEY is set, else OpenAI if OPENAI_API_KEY is set, else local Ollama.

ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-haiku-5-5
# ANTHROPIC_WORKSPACE_ID=

# OPENAI_API_KEY=your_openai_api_key_here

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Demo HR portal login (app/server.mjs); tests sign in with the same values
# DEMO_USERNAME=demo
# DEMO_PASSWORD=demo123

# Seeded bugs to switch on, comma-separated (e.g. BUGS=upload)
# BUGS=
